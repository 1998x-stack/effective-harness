PI_PROVIDER=iagent
PI_MODEL=iagent/standard
PI_THINKING_LEVEL=high
# Optional: defaults to ~/.pi/agent/models.json, where Pi stores the provider and API key.
# PI_MODELS_PATH=/absolute/path/to/models.json
# PI_API_KEY=
# IAUTO_API_KEY=
# Local runtime (target repositories must be trusted).
HARNESS_DATA_DIR=.harness-data
HARNESS_MAX_ROUNDS=3
HARNESS_AGENT_TIMEOUT_MS=1800000
HARNESS_TEST_TIMEOUT_MS=120000
HARNESS_MAX_OUTPUT_BYTES=100000
HARNESS_TEST_IMAGE=effective-harness-tests:local
