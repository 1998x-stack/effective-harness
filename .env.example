# DeepSeek V4.1 Flash official API model ID
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PI_THINKING_LEVEL=off
PI_CONTEXT_WINDOW=131072
PI_MAX_OUTPUT_TOKENS=8192
# Local runtime (target repositories must be trusted).
HARNESS_DATA_DIR=.harness-data
HARNESS_MAX_ROUNDS=3
HARNESS_AGENT_TIMEOUT_MS=240000
HARNESS_TEST_TIMEOUT_MS=120000
HARNESS_MAX_OUTPUT_BYTES=100000
HARNESS_TEST_IMAGE=effective-harness-tests:local
