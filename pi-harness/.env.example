DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PI_THINKING_LEVEL=off
PI_CONTEXT_WINDOW=1000000
PI_MAX_OUTPUT_TOKENS=16384
HARNESS_DATA_DIR=.harness-data
HARNESS_MAX_ROUNDS=3
HARNESS_AGENT_TIMEOUT_MS=240000
HARNESS_TEST_TIMEOUT_MS=120000
HARNESS_MAX_OUTPUT_BYTES=100000
HARNESS_TEST_IMAGE=effective-harness-test:local
# Docker required. Local/host execution intentionally unsupported.
HARNESS_RUNNER_MODE=docker
